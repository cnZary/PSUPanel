<Window x:Class="PSUPanel.Panel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PSUPanel 电源监控" Width="1060" Height="850" MinWidth="900" MinHeight="720"
        WindowStartupLocation="CenterScreen" Background="#0B1118"
        FontFamily="Microsoft YaHei UI, Segoe UI" UseLayoutRounding="True">
    <Window.Resources>
        <SolidColorBrush x:Key="CardBrush" Color="#121C26" />
        <SolidColorBrush x:Key="BorderBrush" Color="#263646" />
        <SolidColorBrush x:Key="TextBrush" Color="#E9F2F8" />
        <SolidColorBrush x:Key="MutedBrush" Color="#93A8B8" />
        <SolidColorBrush x:Key="AccentBrush" Color="#35D0BA" />
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="18" />
        </Style>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,5" />
        </Style>
        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,5" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="MetricValueStyle" TargetType="TextBlock" BasedOn="{StaticResource ValueStyle}">
            <Setter Property="FontSize" Value="27" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="Margin" Value="0,7,0,0" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1E303B" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="#385264" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="13,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#294553" />
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="PSUPanel 电源监控" FontSize="25" FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                    <Border x:Name="StatusDot" Width="8" Height="8" CornerRadius="4" Background="#6B7E8C" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock x:Name="StatusText" Text="正在连接托盘服务" Foreground="{StaticResource MutedBrush}" />
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ComboBox x:Name="PortCombo" MinWidth="130" Margin="0,0,8,0" Background="#F2F6F8" Foreground="#10202A"
                          SelectionChanged="PortCombo_SelectionChanged" ToolTip="选择串口；自动模式只接受有效 CMD02 帧" />
                <Button x:Name="AutoButton" Content="自动" Margin="0,0,8,0" Click="AutoButton_Click" />
                <Button x:Name="RescanButton" Content="重新扫描" Click="RescanButton_Click" />
            </StackPanel>
        </Grid>
        <Border Grid.Row="1" Background="#292516" BorderBrush="#6D5928" BorderThickness="1" CornerRadius="6" Padding="12,9" Margin="0,0,0,16">
            <TextBlock Foreground="#F5D891" TextWrapping="Wrap"
                       Text="只读监控 · 115200 8N1 · 串口独占，请先完全退出 HiMOS。设置命令未启用；型号读取与故障清零共用报文，不会自动发送。" />
        </Border>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <UniformGrid Columns="4" Margin="0,0,0,14">
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="输入功率" Style="{StaticResource LabelStyle}" />
                            <TextBlock x:Name="InputPowerValue" Text="—" Style="{StaticResource MetricValueStyle}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="输入频率" Style="{StaticResource LabelStyle}" />
                            <TextBlock x:Name="InputFrequencyValue" Text="—" Style="{StaticResource MetricValueStyle}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="输入电压" Style="{StaticResource LabelStyle}" />
                            <TextBlock x:Name="InputVoltageValue" Text="—" Style="{StaticResource MetricValueStyle}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="风扇转速" Style="{StaticResource LabelStyle}" />
                            <TextBlock x:Name="FanRpmValue" Text="—" Style="{StaticResource MetricValueStyle}" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="设备信息" Style="{StaticResource SectionTitleStyle}" />
                            <Button x:Name="ReadIdentityButton" Grid.Column="1" Content="手动读取型号 / 序列号"
                                    Click="ReadIdentityButton_Click" IsEnabled="False" />
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="型号" Style="{StaticResource LabelStyle}" />
                            <TextBlock x:Name="ModelValue" Grid.Row="0" Grid.Column="1" Text="—" Style="{StaticResource ValueStyle}" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="序列号" Style="{StaticResource LabelStyle}" />
                            <TextBlock x:Name="SerialValue" Grid.Row="0" Grid.Column="3" Text="—" Style="{StaticResource ValueStyle}" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="额定功率" Style="{StaticResource LabelStyle}" />
                            <TextBlock x:Name="RatedPowerValue" Grid.Row="1" Grid.Column="1" Text="—" Style="{StaticResource ValueStyle}" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="额定输入范围" Style="{StaticResource LabelStyle}" />
                            <TextBlock x:Name="InputRangeValue" Grid.Row="1" Grid.Column="3" Text="—" Style="{StaticResource ValueStyle}" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="效率认证原始码" Style="{StaticResource LabelStyle}" />
                            <TextBlock x:Name="EfficiencyValue" Grid.Row="2" Grid.Column="1" Text="—" Style="{StaticResource ValueStyle}" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="厂商原始字符串" Style="{StaticResource LabelStyle}" />
                            <TextBlock x:Name="VendorValue" Grid.Row="2" Grid.Column="3" Text="—" Style="{StaticResource ValueStyle}" />
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="电流字段 低 / 高" Style="{StaticResource LabelStyle}" />
                            <TextBlock x:Name="RatedCurrentValue" Grid.Row="3" Grid.Column="1" Text="—" Style="{StaticResource ValueStyle}" />
                            <TextBlock Grid.Row="3" Grid.Column="2" Text="保修显示" Style="{StaticResource LabelStyle}" />
                            <TextBlock x:Name="WarrantyValue" Grid.Row="3" Grid.Column="3" Text="—" Style="{StaticResource ValueStyle}" />
                        </Grid>
                        <TextBlock Margin="0,12,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                   Text="读取操作发送 55 7E 04 1E 00 00 22 AE；此帧与故障清零命令完全相同，需要两次确认，且只发送一次、不重试。" />
                    </StackPanel>
                </Border>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="输出电压" Style="{StaticResource SectionTitleStyle}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="+3.3 V" Style="{StaticResource LabelStyle}" />
                                <TextBlock x:Name="Voltage3V3Value" Grid.Row="0" Grid.Column="1" Text="—" Style="{StaticResource ValueStyle}" />
                                <TextBlock Grid.Row="1" Text="+5 V" Style="{StaticResource LabelStyle}" />
                                <TextBlock x:Name="Voltage5Value" Grid.Row="1" Grid.Column="1" Text="—" Style="{StaticResource ValueStyle}" />
                                <TextBlock Grid.Row="2" Text="+12 V" Style="{StaticResource LabelStyle}" />
                                <TextBlock x:Name="Voltage12Value" Grid.Row="2" Grid.Column="1" Text="—" Style="{StaticResource ValueStyle}" />
                                <TextBlock Grid.Row="3" Text="5VSB 待机" Style="{StaticResource LabelStyle}" />
                                <TextBlock x:Name="StandbyVoltageValue" Grid.Row="3" Grid.Column="1" Text="—" Style="{StaticResource ValueStyle}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="温度与状态" Style="{StaticResource SectionTitleStyle}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="高压侧温度" Style="{StaticResource LabelStyle}" />
                                <TextBlock x:Name="HighTemperatureValue" Grid.Row="0" Grid.Column="1" Text="—" Style="{StaticResource ValueStyle}" />
                                <TextBlock Grid.Row="1" Text="低压侧温度" Style="{StaticResource LabelStyle}" />
                                <TextBlock x:Name="LowTemperatureValue" Grid.Row="1" Grid.Column="1" Text="—" Style="{StaticResource ValueStyle}" />
                                <TextBlock Grid.Row="2" Text="环境温度" Style="{StaticResource LabelStyle}" />
                                <TextBlock x:Name="AmbientTemperatureValue" Grid.Row="2" Grid.Column="1" Text="—" Style="{StaticResource ValueStyle}" />
                                <TextBlock Grid.Row="3" Text="风扇模式原值" Style="{StaticResource LabelStyle}" />
                                <TextBlock x:Name="FanModeValue" Grid.Row="3" Grid.Column="1" Text="—" Style="{StaticResource ValueStyle}" />
                                <TextBlock Grid.Row="4" Text="故障码（无位定义）" Style="{StaticResource LabelStyle}" />
                                <TextBlock x:Name="FaultCodeValue" Grid.Row="4" Grid.Column="1" Text="—" Style="{StaticResource ValueStyle}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="CMD04 原始字段" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Foreground="#F5D891" TextWrapping="Wrap" Margin="0,0,0,12"
                                   Text="物理意义未确认。以下仅将 28 字节 Payload 依次按无符号小端 u16 展示，不代表已确认的字段类型、名称或缩放。" />
                        <ItemsControl x:Name="RawWords">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="7" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#0D151D" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Margin="3" Padding="7">
                                        <StackPanel>
                                            <TextBlock Text="{Binding OffsetText}" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                            <TextBlock Text="{Binding ValueText}" Foreground="{StaticResource TextBrush}" FontFamily="Consolas" FontSize="15" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="原始 Payload" Style="{StaticResource LabelStyle}" Margin="0,14,0,4" />
                        <TextBlock x:Name="RawPayloadValue" Text="—" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,4">
                    <StackPanel>
                        <TextBlock Text="已校验原始帧" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="CMD02 遥测" Style="{StaticResource LabelStyle}" />
                        <TextBlock x:Name="RawTelemetryValue" Text="—" FontFamily="Consolas" FontSize="10" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" />
                        <TextBlock Text="CMD04" Style="{StaticResource LabelStyle}" Margin="0,10,0,0" />
                        <TextBlock x:Name="RawCommand04Value" Text="—" FontFamily="Consolas" FontSize="10" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="MessageText" Text="正在启动" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
            <TextBlock x:Name="LastUpdateText" Grid.Column="1" Text="—" Foreground="{StaticResource MutedBrush}" Margin="18,0,0,0" />
        </Grid>
    </Grid>
</Window>
